<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Sem listagem de diretorio -->
    <directoryBrowse enabled="false" />

    <!-- Cabecalhos de seguranca. O controle de acesso fica no PHP
         (_lib.php): allowlist de IP + sessao + CSRF. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options"        value="DENY" />
        <add name="Referrer-Policy"        value="same-origin" />
        <add name="Cache-Control"          value="no-store" />
      </customHeaders>
    </httpProtocol>

    <!-- Nao se usa <requestFiltering><fileExtensions allowUnlisted="false"> aqui:
         ele faz o IIS devolver 404.7 na requisicao de diretorio
         (http://127.0.0.1/painel/). A pasta so contem .php e .css. -->
    <security>
      <requestFiltering>
        <add segment="." />
        <add segment=".." />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>