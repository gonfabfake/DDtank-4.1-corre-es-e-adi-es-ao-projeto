<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Sem listagem de diretorio -->
    <directoryBrowse enabled="false" />

    <!-- Cabecalhos de seguranca. O controle de acesso fica no PHP
         (_lib.php): allowlist de IP + sessao + CSRF. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options"        value="DENY" />
        <add name="Referrer-Policy"        value="same-origin" />
        <!-- Sem Cache-Control aqui: o PHP envia no-store para as paginas e o
             img.php envia immutable para as imagens espelhadas. Se ficar aqui,
             o no-store sobrescreve o cache das imagens. -->
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>